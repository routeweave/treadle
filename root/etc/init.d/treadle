#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 RouteWeave

# rc.common reads these three.
# shellcheck disable=SC2034
USE_PROCD=1
START=95
STOP=05

BUILD_CONFIG=/usr/libexec/treadle/build-config
FIREWALL=/usr/libexec/treadle/firewall.sh
SINGBOX=/usr/bin/sing-box
# procd runs sing-box through this wrapper: it rebuilds the config first when
# the installed sing-box is not the version the config was built for. It is
# named sing-box so procd tags the log lines `sing-box[pid]` (see its header).
RUN_SINGBOX=/usr/libexec/treadle/sing-box
# Managed-DNS drop-in, generated by build-config from its LOCAL_DOMAINS list.
DNSMASQ_DROPIN_SRC=/var/etc/treadle/dnsmasq-managed.conf
# Transient pause marker. Set by the Status page Stop button to suppress
# autostart and the cron watchdog until the user clicks Start (or the
# router reboots — /var/run is tmpfs, so the marker dies with the box and
# an enabled service resumes naturally on next boot).
PAUSE_MARKER=/var/run/treadle.paused

# treadle_log — shared with firewall.sh
. /usr/libexec/treadle/common.sh

install_crons() {
	# Treadle drives every periodic task from two cron entries: one hourly
	# maintenance tick (/usr/libexec/treadle/hourly — subscription auto-update
	# and the daily rule-set refresh, each self-gated inside that script) and
	# one */5 recovery watchdog. Grep-gated, so this is a no-op once present.
	local changed
	changed=0

	# Sweep the pre-consolidation sync-subscriptions / fetch-rulesets lines
	# (and the pre-jitter fixed `0 * * * *` sync line) left by an older Treadle;
	# the hourly tick now subsumes both.
	if grep -qsE 'treadle/(sync-subscriptions|fetch-rulesets)' /etc/crontabs/root 2>/dev/null; then
		sed -i -e '/treadle\/sync-subscriptions/d' -e '/treadle\/fetch-rulesets/d' \
			/etc/crontabs/root
		changed=1
	fi

	# Hourly tick. Random minute 0–59 so a fleet of routers doesn't all hit
	# the subscription / rule-set providers at the same instant. awk (always
	# present on OpenWrt) gives a POSIX-portable PRNG; $RANDOM is a bashism
	# that busybox ash happens to support but POSIX does not.
	grep -qsF "treadle/hourly" /etc/crontabs/root 2>/dev/null || {
		local minute
		minute=$(awk 'BEGIN{srand();print int(rand()*60)}')
		echo "$minute * * * * /usr/libexec/treadle/hourly" >> /etc/crontabs/root
		changed=1
	}

	# Recovery watchdog every 5 minutes — a downed sing-box must be caught
	# quickly. No jitter: local-only work that contacts no remote server.
	grep -qsF "treadle/watchdog" /etc/crontabs/root 2>/dev/null || {
		echo "*/5 * * * * /usr/libexec/treadle/watchdog" >> /etc/crontabs/root
		changed=1
	}

	[ "$changed" = 1 ] && /etc/init.d/cron reload 2>/dev/null
}

# Resolve the conf-dir the running dnsmasq instance loads its drop-ins from.
# OpenWrt's dnsmasq.init computes it deterministically, per instance, as
#   config_get dnsmasqconfdir "$cfg" confdir "/tmp/dnsmasq${cfg:+.$cfg}.d"
# Mirror that exactly: derive it from the dnsmasq UCI section name plus an
# explicit `confdir` override if the user set one. The previous version
# parsed the conf-dir= line out of dnsmasq's *generated*
# /var/etc/dnsmasq.conf.<section> instead — which at boot is unreliable: it
# may not exist yet, be half-written by an in-flight dnsmasq restart, or be
# read before its conf-dir= line. Every such failure fell back to
# /tmp/dnsmasq.d, a directory dnsmasq on 25.12 never reads, so the drop-in
# landed where it had no effect and dnsmasq kept answering LAN clients from
# the WAN/ISP (DNS-poisoned) resolvers. UCI is always readable, so deriving
# the path from it works regardless of dnsmasq's runtime state.
dnsmasq_confdir() {
	local section confdir
	section=$(uci -q show dhcp.@dnsmasq[0] 2>/dev/null \
		| sed -n '1s/^dhcp\.\([^.=]*\).*/\1/p')
	[ -n "$section" ] || { echo /tmp/dnsmasq.d; return; }
	confdir=$(uci -q get "dhcp.$section.confdir" 2>/dev/null)
	[ -n "$confdir" ] || confdir="/tmp/dnsmasq.$section.d"
	echo "$confdir"
}

install_dns_dropin() {
	# Managed DNS: hand dnsmasq its forwarding instructions for sing-box's
	# dns-in inbound. The drop-in must land in the conf-dir dnsmasq actually
	# loads (see dnsmasq_confdir). The generated source is deterministic, so
	# an identical copy already in place needs no dnsmasq restart (avoids
	# churn on every reload trigger). build-config writes the source earlier
	# in start_service, so it is present by the time we run.
	[ -f "$DNSMASQ_DROPIN_SRC" ] || return 0

	local confdir dropin
	confdir=$(dnsmasq_confdir)
	dropin="$confdir/treadle.conf"

	# Sweep drop-ins left in stale directories: the old fixed
	# /tmp/dnsmasq.d location, plus every /tmp/dnsmasq.*.d the user's
	# dnsmasq instance(s) may have used previously (e.g. after a UCI
	# section rename). Glob may match nothing on a fresh system; the
	# stray-files trap suppresses that case.
	for stale in /tmp/dnsmasq.d/treadle.conf /tmp/dnsmasq.*.d/treadle.conf; do
		[ -f "$stale" ] && [ "$stale" != "$dropin" ] && rm -f "$stale"
	done

	mkdir -p "$confdir"
	cmp -s "$DNSMASQ_DROPIN_SRC" "$dropin" 2>/dev/null && return 0
	cp "$DNSMASQ_DROPIN_SRC" "$dropin"
	# conf-dir is read only at process start, so a reload won't pick this up.
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	treadle_log info "dns: managed DNS drop-in installed in $confdir, dnsmasq routed through sing-box"
}

remove_dns_dropin() {
	# Sweep every possible drop-in location, not just the dnsmasq section
	# that currently resolves at @dnsmasq[0]: a UCI section rename or
	# instance removal between start and stop would otherwise leave an
	# orphan treadle.conf that the renamed dnsmasq instance still picks up
	# on next restart.
	local dropin removed=0
	for dropin in /tmp/dnsmasq.d/treadle.conf /tmp/dnsmasq.*.d/treadle.conf; do
		[ -f "$dropin" ] && { rm -f "$dropin"; removed=1; }
	done
	[ "$removed" = 1 ] || return 0
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	treadle_log info "dns: managed DNS drop-in removed, dnsmasq restored to its own resolvers"
}

# Declare the procd instance for sing-box, running it against the config file
# given as $1. Factored out so the config-error fallback in start_service can
# re-declare the existing instance — leaving the running process untouched —
# without duplicating the parameter list.
treadle_declare_instance() {
	# Named `singbox` so service_running() in luci.treadle and the cron
	# watchdog can query this instance specifically via ubus's `instance`
	# filter, rather than substring-grepping for `"running":true` in the
	# combined service list — which would also match active_watch and
	# defeat the watchdog's whole purpose when clash API is enabled.
	procd_open_instance singbox
	procd_set_param command "$RUN_SINGBOX" "$1"
	# procd respawns a crashed sing-box; after a burst of fast crashes it
	# hits its retry limit and gives up. /usr/libexec/treadle/watchdog, run
	# from cron, then re-arms the service.
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Watch the generated config plus the sing-box binary. procd restarts the
	# instance on an out-of-band config edit and, after a package upgrade
	# swaps /usr/bin/sing-box, the next start_service run (any UCI commit,
	# WAN-up, manual restart) re-execs the new binary instead of leaving the
	# pre-upgrade process running. Same `file`-hash trick as active-watch above.
	procd_set_param file "$1" "$SINGBOX"
	procd_close_instance
}

# Second procd instance: the active-node watcher. Polls sing-box's loopback
# clash API at /proxies every 10s and logs every urltest flip to
# syslog — the diagnostic trail a user needs to decide whether their
# `tolerance` / `interval` are tuned too aggressively. Only declared when
# the clash API itself is enabled (otherwise the daemon has nothing to talk
# to). Restarts in lockstep with sing-box: when the UCI flag flips off, a
# reload re-enters start_service, this function returns without declaring
# the instance, and procd's instance reconciliation tears the daemon down.
treadle_declare_active_watch() {
	local clash_api_enabled
	config_get_bool clash_api_enabled global clash_api_enabled 0
	[ "$clash_api_enabled" = "1" ] || return 0
	procd_open_instance active_watch
	procd_set_param command /usr/libexec/treadle/active-watch
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Hash the script itself, mirroring what we do for sing-box's
	# config file. Without this, procd treats every reload as "same
	# instance, no work to do" — even after the package upgrade
	# rewrites the script on disk. The OLD Lua interpreter then keeps
	# running indefinitely, silently shipping pre-upgrade behaviour.
	# With `file` set, an apk upgrade triggers an automatic restart
	# the next time start_service runs (which happens on every UCI
	# commit via the reload trigger).
	procd_set_param file /usr/libexec/treadle/active-watch
	procd_close_instance
}

start_service() {
	# Serialise concurrent invocations. set_enabled / start / restart /
	# set_mode / set_extra_config all commit UCI and may also fork
	# /etc/init.d/treadle start explicitly, plus the procd reload trigger
	# fires on every commit — so two start_service runs can race on the
	# same ${config_path}.next file (build, validate, atomic rename).
	#
	# Wait for the running one rather than skipping: it may have read UCI
	# before the commit that triggered this start, and a skipped start
	# would leave that change unapplied until some later reload. The wait
	# is bounded so a lock leaked by a killed start cannot hang every
	# future one.
	local tries
	tries=0
	mkdir -p /var/lock
	while ! lock -n /var/lock/treadle-start.lock 2>/dev/null; do
		tries=$((tries + 1))
		if [ "$tries" -ge 30 ]; then
			treadle_log warn "service: start lock held for 30 s, skipping this start"
			return 0
		fi
		sleep 1
	done
	trap 'lock -u /var/lock/treadle-start.lock 2>/dev/null' EXIT

	# Ensure the directories that hold sensitive files (proxy credentials in
	# /etc/treadle/nodes/*.json and extra.json, runtime snapshots and the
	# generated sing-box.json in /var/etc/treadle) are 0700-owned by root.
	# Default umask 0022 would leave them world-readable, and re-applying the
	# mode on every start also corrects a directory created by hand.
	for d in /etc/treadle /etc/treadle/nodes /var/etc/treadle; do
		mkdir -p "$d"
		chmod 0700 "$d"
	done

	# luci.treadle caches `sing-box version` in tmpfs to keep the 5s Overview
	# poll from forking sing-box. Drop it on every (re)start so a package
	# upgrade's new version is re-detected on the next read — otherwise the
	# footer shows the pre-upgrade version until a reboot clears tmpfs.
	rm -f /var/etc/treadle/.singbox-version

	# Fix up any subscription whose node_count/status (plain UCI fields in
	# the /etc/config/treadle conffile) survived a reinstall while its
	# /etc/treadle/nodes/<uid>.json did not — see reconcile_subscriptions in
	# luci.treadle. Runs regardless of the `enabled` gate below, so the Nodes
	# tab is honest even before the user re-enables/re-syncs anything.
	ubus call luci.treadle reconcile_subscriptions '{}' >/dev/null 2>&1

	local enabled config_path mode cfg_warn chk tmp_cfg config_ok level

	config_load treadle
	config_get_bool enabled global enabled 0

	# The UCI `enabled` flag is the persistent master switch: 0 means Treadle
	# is installed but dormant — start_service opens no procd instance and
	# the service stays stopped across reboots. Flipped from the UI by the
	# Status page Enable toggle (set_enabled RPC); reload_service routes a
	# disabled service to stop.
	[ "$enabled" = "1" ] || return 1

	config_get config_path global config_path /var/etc/treadle/sing-box.json
	config_get mode inbounds mode tproxy

	# Transient pause: the Status page Stop button writes PAUSE_MARKER and
	# calls /etc/init.d/treadle stop, so the service stops without flipping
	# the persistent `enabled` flag. Honour the marker here too — any later
	# reload trigger (UCI commit, WAN-up) re-enters start_service and would
	# otherwise undo the pause. The marker is on tmpfs, so a reboot clears
	# it and an enabled-but-paused service comes back automatically.
	if [ -e "$PAUSE_MARKER" ]; then
		treadle_log info "service: paused by user, not starting (clear via Status page Start)"
		return 1
	fi

	# Defer the first start until there is a route out. sing-box's remote
	# rule-set initialization and urltest probes need connectivity, and at
	# cold boot the WAN (DHCP/PPPoE) is not up yet when /etc/rc.d/S95treadle
	# runs — starting then leaves sing-box routeless, flooding "no route to
	# internet". With no default route and OUR sing-box not already running,
	# return without an instance: the `interface.*.up wan` trigger re-runs
	# start_service once the WAN comes up (one clean start), and the */5
	# watchdog cron is a backstop. The guard limits the wait to the
	# genuine first start, so a Save during a WAN outage never stops a
	# healthy instance.
	#
	# `pgrep -f` plus the treadle config_path discriminates between OUR
	# sing-box and an independently-installed one (e.g. a homeassistant
	# add-on) — without it, an unrelated sing-box on the box would
	# silently bypass the WAN gate.
	if ! pgrep -f "sing-box .*-c .*${config_path}" >/dev/null 2>&1; then
		if [ -z "$(ip -4 route show default 2>/dev/null)" ] && \
		   [ -z "$(ip -6 route show default 2>/dev/null)" ]; then
			treadle_log info "service: no default route yet, waiting for WAN"
			return 1
		fi
	fi

	# Several safety nets rely on config_path living on tmpfs (/var/etc/treadle):
	# the "refuse to start with no working config after reboot" gate at line
	# 327, and the fact that a saved-broken config can't persist across a
	# reboot. A user who points config_path at flash storage (e.g.
	# /etc/sing-box/config.json) loses both guarantees. Warn once per start
	# so the implication is visible in the Treadle log without being noisy.
	case "$config_path" in
		/var/etc/treadle/*|/var/run/treadle/*|/tmp/*) ;;
		*) treadle_log warn "config: config_path '$config_path' is not on tmpfs — a broken config may persist across reboots and the no-working-config safety net is disabled" ;;
	esac

	# Regenerate the sing-box JSON to a side path and validate it there, then
	# promote it over the live config_path only once it is known good. A
	# rejected config therefore never overwrites the last working one — and,
	# crucially, the failure path can still declare a procd instance (see
	# below) rather than returning empty-handed and having procd stop a
	# sing-box that is currently running fine.
	tmp_cfg="${config_path}.next"
	config_ok=1
	if [ -x "$BUILD_CONFIG" ]; then
		# build-config's diagnostics go to stderr; route them into syslog so
		# degraded states (invalid extra.json, dropped DNS rules, WAN-down
		# DNS) stay visible.
		#
		# Severity is per-invocation (warn after a successful run, err after
		# a failed one), which on its own would put routine audit output (the
		# regex-group admit counts, one line per contributing source per
		# group, on every apply) at the same level as "dropping its nodes".
		# Lines build-config tags `info:` are split off and logged at
		# daemon.info so what is left at warn/err is only what actually went
		# wrong. Two grep/logger pipelines rather than a read loop: the cost stays
		# constant instead of forking a logger per diagnostic line, and
		# busybox logger on empty stdin logs nothing, so an absent stream
		# needs no guard.
		cfg_warn=$("$BUILD_CONFIG" "$tmp_cfg" 2>&1 >/dev/null) || config_ok=0
		if [ -n "$cfg_warn" ]; then
			if [ "$config_ok" = "1" ]; then level=warn; else level=err; fi
			echo "$cfg_warn" | grep '^treadle build-config: info: ' \
				| sed 's/^treadle build-config: info: /config: /' \
				| logger -p daemon.info -t treadle
			echo "$cfg_warn" | grep -v '^treadle build-config: info: ' \
				| sed 's/^treadle build-config: /config: /' \
				| logger -p "daemon.$level" -t treadle
		fi
	else
		config_ok=0
		treadle_log err "config: build-config is missing, cannot generate sing-box config"
	fi

	# Validate the generated config before handing it to procd. sing-box runs
	# under procd `respawn`, so a config it rejects (e.g. a malformed DNS
	# server address) would otherwise crash-loop forever.
	if [ "$config_ok" = "1" ] && [ -x "$SINGBOX" ]; then
		chk=$("$SINGBOX" check -c "$tmp_cfg" 2>&1) || {
			config_ok=0
			[ -n "$chk" ] && echo "$chk" | logger -p daemon.err -t treadle
		}
	fi

	if [ "$config_ok" != "1" ]; then
		rm -f "$tmp_cfg" "$tmp_cfg.sbver"
		# The freshly generated config is unusable. Returning now without a
		# procd instance would make procd reconcile an empty instance set and
		# STOP a sing-box that is running fine — so a single bad Save would
		# take the LAN down. Instead, when a last working config_path exists,
		# keep procd pointed at it: re-declaring the unchanged instance leaves
		# a running process exactly as it is (same command and file hash, so
		# procd does nothing). The firewall / DNS / cron steps are skipped so
		# the environment stays consistent with the config still in use. Only
		# an initial start with nothing usable on disk genuinely refuses —
		# config_path lives on tmpfs, so at boot it is always absent and a
		# broken config correctly prevents startup.
		if [ ! -f "$config_path" ]; then
			treadle_log err "config: generation failed and no working config exists, not starting sing-box"
			return 1
		fi
		treadle_log err "config: generated config was rejected, keeping sing-box on the last working config"
		treadle_declare_instance "$config_path"
		# Re-declare active_watch only if the last-working config (the one
		# we're keeping running) actually has clash_api enabled. Without
		# this re-declaration, procd reconciles a missing instance and
		# kills the running watcher — even though the live sing-box is
		# still serving its clash API. Don't trust the current UCI flag
		# here: build-config may have changed clash_api_enabled in the
		# rejected config, so we inspect the still-running file.
		if grep -q '"clash_api"' "$config_path" 2>/dev/null; then
			treadle_declare_active_watch
		fi
		return 0
	fi

	# Promote the validated config over the live one. The rename is atomic
	# (same tmpfs directory); procd's `file` watch hashes the content, so an
	# unchanged config still yields no restart. Compare before the rename to
	# record which case applies — a Save that produces an identical config is
	# otherwise indistinguishable from one that actually restarted sing-box.
	if [ ! -f "$config_path" ]; then
		treadle_log notice "config: writing initial sing-box config ($mode mode)"
	elif cmp -s "$tmp_cfg" "$config_path"; then
		treadle_log info "config: sing-box config unchanged, no restart"
	else
		treadle_log notice "config: sing-box config changed, restarting sing-box"
		# procd's file watch will restart sing-box on the rename below;
		# its cumulative clash counters reset in-process. Clear the
		# stale snapshots so the Status traffic row doesn't show
		# pre-restart totals for the ~10s it takes active-watch to
		# write fresh values.
		rm -f /var/etc/treadle/.active-nodes.json /var/etc/treadle/.clash-stats.json
	fi

	mv "$tmp_cfg" "$config_path"
	# The version stamp build-config wrote beside it (see /usr/libexec/treadle/sing-box).
	mv -f "$tmp_cfg.sbver" "$config_path.sbver" 2>/dev/null
	treadle_declare_instance "$config_path"
	treadle_declare_active_watch

	# Install TPROXY nftables rules + policy routing. No-op for tun mode.
	local firewall_ok=1
	if [ -x "$FIREWALL" ]; then
		"$FIREWALL" start || firewall_ok=0
	fi

	# Managed DNS: hand dnsmasq over to sing-box. The generated config has
	# already passed `sing-box check`, so the drop-in can be installed
	# unconditionally; when disabled, clear any stale drop-in. But if the
	# TPROXY ruleset failed to load, handing DNS to sing-box would resolve
	# names (possibly into fake-IP ranges) with no ruleset in place to
	# redirect the resulting traffic into sing-box — leaving LAN clients
	# with addresses they can't reach. Keep dnsmasq on its own resolvers
	# until the firewall step actually succeeds.
	local managed_dns
	config_get_bool managed_dns dns managed_dns 1
	if [ "$managed_dns" = "1" ] && [ "$firewall_ok" = "1" ]; then
		install_dns_dropin
	else
		[ "$managed_dns" = "1" ] && [ "$firewall_ok" = "0" ] && \
			treadle_log warn "dns: firewall setup failed, keeping dnsmasq on its own resolvers"
		remove_dns_dropin
	fi

	# Install the hourly maintenance tick and the recovery-watchdog cron.
	# Grep-gated, so this is a no-op once the lines are present.
	install_crons

	# Rule-sets are sing-box `remote` rule-sets — sing-box downloads and
	# refreshes them itself, so there is nothing to fetch here.

	return 0
}

stop_service() {
	treadle_log info "service: stopping sing-box"

	[ -x "$FIREWALL" ] && "$FIREWALL" stop

	# Return dnsmasq to its own resolvers before sing-box's dns-in goes away.
	remove_dns_dropin

	# Clear the active-node and clash-stats snapshots so the Status page
	# doesn't keep displaying last-known members, latencies, or traffic
	# counters after the daemon writing them has been killed by procd.
	# Without this the panels would show stale data with no "service is
	# down" cue, and after a service restart the cumulative totals would
	# carry over from the previous instance for up to one active-watch
	# tick (~10s).
	rm -f /var/etc/treadle/.active-nodes.json /var/etc/treadle/.clash-stats.json

	# Cron lines are left in place. The watchdog respects PAUSE_MARKER and
	# the persistent `enabled` flag, so it self-suppresses for transient
	# pauses and for an explicitly-disabled service. Removing the watchdog
	# cron here defeats its purpose: a manually-stopped service with
	# enabled=1 would have no path back to running until someone calls
	# `start` again. The hourly tick is similarly safe — sync-subscriptions
	# only updates the local cache, and reload_if_changed routes through
	# reload_service which honours both gates. Package removal is the
	# right place to delete the lines, not service stop.
}

reload_service() {
	# Fired by the procd reload trigger (every UCI commit) and by the WAN-up
	# interface trigger declared in service_triggers. Route through start/stop
	# so the `enabled` flag stays authoritative: a Save that turns Treadle off
	# tears sing-box down, one that leaves it on re-applies the config.
	#
	# The apply path is a plain `start`, not `stop; start`: start_service is
	# idempotent — install_sync_cron and install_dns_dropin are grep/cmp-gated
	# no-ops when already current, and procd restarts sing-box only when the
	# generated JSON actually changed (the `file` param). So a Save that does
	# not change the config is side-effect-free, without the dnsmasq and
	# sync-cron churn a full stop; start would cause.
	local enabled
	config_load treadle
	config_get_bool enabled global enabled 0
	if [ "$enabled" = "1" ]; then
		start
	else
		stop
	fi
}

service_triggers() {
	# React to settings Saves and to the WAN coming up. The interface trigger
	# replaces the old standalone /etc/hotplug.d/iface/40-treadle script: procd
	# owns it and registers it only as part of this service, so it cannot
	# fire — and be refused — before the boot-time start, the way a
	# free-standing hotplug script raced S95treadle.
	procd_add_reload_trigger treadle
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/treadle reload
}
