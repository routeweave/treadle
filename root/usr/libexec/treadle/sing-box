#
# /usr/libexec/treadle/sing-box <config> — the command procd runs for the
# managed sing-box.
#
# The file is named `sing-box` on purpose. procd tags an instance's
# stdout/stderr in syslog with the basename of the command it started, and
# keeps that tag after the command execs something else. Under any other
# name every sing-box log line would be tagged with the wrapper's name, and
# everything that finds them by `sing-box` (the Status page log view,
# `logread -e sing-box`) would lose them.
#
# build-config shapes its output for the sing-box version installed when it
# ran and records that version in <config>.sbver. procd restarts sing-box on
# its own (respawn after a crash, the file watch on the binary), and none of
# those paths rebuild the config. After a sing-box upgrade the new binary
# could therefore start on a config built for the old one, which is at best
# deprecated and, once a release removes a field Treadle still emits,
# rejected: a crash loop with the firewall still steering the LAN into it.
#
# So before every start, compare the installed version with the stamp. On a
# match, exec sing-box straight away. On a mismatch, rebuild the config the
# way the init script does (build to a side path, `sing-box check`, atomic
# rename) under the same start lock, then exec. A rebuild that fails keeps
# the existing config: it may still run, and the watchdog covers it if not.

SINGBOX=/usr/bin/sing-box
BUILD_CONFIG=/usr/libexec/treadle/build-config
LOCK=/var/lock/treadle-start.lock

cfg="$1"
[ -n "$cfg" ] || { echo "usage: $0 <config>" >&2; exit 2; }

log() { logger -p "daemon.$1" -t treadle "$2"; }

# build-config's stderr, split as start_service splits it: `info:` lines at
# daemon.info, the rest at the given level. busybox logger logs nothing on
# empty input, so an absent stream needs no guard.
log_build_output() {
	echo "$err" | grep '^treadle build-config: info: ' \
		| sed 's/^treadle build-config: info: /config: /' | logger -p daemon.info -t treadle
	echo "$err" | grep -v '^treadle build-config: info: ' \
		| sed 's/^treadle build-config: /config: /' | logger -p "daemon.$1" -t treadle
}

have=$("$SINGBOX" version 2>/dev/null | head -n 1)
built=$(cat "$cfg.sbver" 2>/dev/null)

if [ -n "$have" ] && [ "$have" != "$built" ]; then
	log notice "config: built for '${built:-unknown}', installed is '$have'"
	# Rebuild only while holding the start lock: the init script writes the
	# same <cfg>.next and .next.sbver. After 30 s, give up as the init script
	# does and start on the existing config rather than race whoever holds it.
	mkdir -p /var/lock
	locked=0
	tries=0
	while [ "$tries" -lt 30 ]; do
		lock -n "$LOCK" 2>/dev/null && { locked=1; break; }
		tries=$((tries + 1))
		sleep 1
	done
	if [ "$locked" = 1 ]; then
		# The status-page footer caches the version; a new binary makes it stale.
		rm -f /var/etc/treadle/.singbox-version
		next="$cfg.next"
		built_ok=0
		checked_ok=0
		err=$("$BUILD_CONFIG" "$next" 2>&1 >/dev/null) && built_ok=1
		[ "$built_ok" = 1 ] && chk=$("$SINGBOX" check -c "$next" 2>&1) && checked_ok=1
		if [ "$checked_ok" = 1 ]; then
			mv -f "$next" "$cfg"
			mv -f "$next.sbver" "$cfg.sbver"
			log_build_output warn
			log notice "config: rebuilt for '$have'"
		else
			rm -f "$next" "$next.sbver"
			# As start_service does: the builder's own lines are warnings when
			# it succeeded and only the check rejected its output.
			if [ "$built_ok" = 1 ]; then log_build_output warn; else log_build_output err; fi
			[ -n "$chk" ] && echo "$chk" | logger -p daemon.err -t treadle
			log err "config: rebuild for '$have' failed, starting on the existing config"
		fi
		lock -u "$LOCK" 2>/dev/null
	else
		log err "config: start lock held for 30 s, not rebuilding; starting on the existing config"
	fi
fi

exec "$SINGBOX" run -c "$cfg"
