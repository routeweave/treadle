-- Active-node watcher — long-running daemon that polls sing-box's clash API
-- at /proxies every POLL_S seconds and logs to syslog whenever the currently
-- active member (the `now` field) of any urltest group changes. Provides
-- the diagnostic trail a user needs to decide whether their urltest
-- `tolerance` / `interval` are tuned too aggressively for their network.
--
-- Lifecycle: a procd instance declared by /etc/init.d/treadle alongside the
-- sing-box instance, gated on UCI treadle.global.clash_api_enabled. Stops and
-- starts with the service; respawned by procd if it crashes.
--
-- Snapshot at /var/etc/treadle/.active-nodes.json (tmpfs — cleared on reboot,
-- which is fine: the first tick after boot primes the snapshot without
-- emitting a change line). The same file backs the Status page's "Nodes in
-- use" panel via the get_active_groups RPC, so the UI sees the same view
-- this watcher logs against.
--
-- Once a minute it also tests the nodes that are in use but in no group
-- (the default node or a rule's node), which sing-box never tests itself,
-- and runs the connectivity check: one test through the node the default
-- resolves to. Both go into the same snapshot.
--
-- With global.group_manager = treadle the groups are sing-box selectors and
-- this daemon picks their nodes (see manage_groups below and groupman.lua).
-- It then runs whether or not clash_api_enabled is set.

local jsonc = require "luci.jsonc"
local lib   = dofile("/usr/libexec/treadle/treadlelib.lua")
local read_file = lib.read_file

local CLASH_HOST   = "127.0.0.1:9090"
local SNAPSHOT     = "/var/etc/treadle/.active-nodes.json"
local STATS_SNAP   = "/var/etc/treadle/.clash-stats.json"
local POLL_S       = 10

-- The traffic snapshot only feeds the Status page, and /connections carries
-- the whole connection list (tens of KB on a busy router) just to be
-- counted. get_clash_stats writes the epoch into STATUS_VIEWED on every
-- Status tick; while it is recent, /connections is fetched every tick,
-- otherwise once per STATS_IDLE_S. The idle fetches keep a baseline, so a
-- page that opens shows a rate at most that old, and a live one within a tick.
local STATUS_VIEWED = "/var/etc/treadle/.status-viewed"
local VIEWED_WINDOW_S = 30
local STATS_IDLE_S    = 60

-- Pending log lines accumulated during the current tick. Flushed at the
-- end of each iteration via a single `logger` fork that reads them from
-- stdin — important because a WAN flap can fan into dozens of group-flip
-- events in one tick, and serial fork-per-line of busybox logger costs
-- ~200ms each on MIPS, easily pushing the 10s poll cadence over the edge.
local pending_log = {}

local function logmsg(level, msg)
	-- Tag names ultimately come from URL-decoded subscription content, so a
	-- node tag may legitimately contain any byte including newlines, NULs
	-- and other control chars (an attacker subscription could also craft
	-- one deliberately). Scrub control chars to spaces so a literal `\n`
	-- in the message can't fan one queued entry into multiple syslog lines.
	-- Normalise the colloquial 'warn' to POSIX 'warning' so the get_logs
	-- filter (which keys SEV by the canonical name) classifies the line
	-- correctly. busybox logger accepts both spellings.
	if level == "warn" then level = "warning" end
	local safe = msg:gsub("[%c]", " ")
	pending_log[#pending_log + 1] = { level = level, msg = safe }
end

-- Flush queued log lines: group by level (logger uses one priority per
-- invocation) and pipe each group's messages via stdin. Worst case is
-- 4-5 forks per tick regardless of how many flips happened.
local function flush_log()
	if #pending_log == 0 then return end
	local by_level = {}
	for _, e in ipairs(pending_log) do
		local b = by_level[e.level]
		if not b then b = {}; by_level[e.level] = b end
		b[#b + 1] = e.msg
	end
	pending_log = {}
	for level, msgs in pairs(by_level) do
		-- Single-quoted heredoc: literal-quoted body so the messages
		-- need no further shell escaping. Use a sentinel unlikely to
		-- appear in any message (control chars already stripped above
		-- guarantee no embedded newline can break out).
		local f = io.popen("logger -p daemon." .. level
			.. " -t treadle 2>/dev/null", "w")
		if f then
			for _, m in ipairs(msgs) do f:write(m, "\n") end
			f:close()
		end
	end
end

-- One GET to a loopback clash API path ("/proxies", "/connections").
-- Returns the parsed response object, or nil on any failure (port not
-- listening yet, malformed body, etc.). Transient failures are silent:
-- the daemon retries on the next tick.
local function fetch_json(api_path)
	local f = io.popen("uclient-fetch --timeout=5 -qO- 'http://"
		.. CLASH_HOST .. api_path .. "' 2>/dev/null")
	if not f then return nil end
	local body = f:read("*a") or ""
	f:close()
	if body == "" then return nil end
	local ok, parsed = pcall(jsonc.parse, body)
	if not ok or type(parsed) ~= "table" then return nil end
	return parsed
end

-- Atomically write one JSON snapshot (tmp + rename). The consumers (the
-- get_active_groups / get_clash_stats RPCs) tolerate a missing file, so a
-- write skip on failure is fine. No mkdir or chmod per write: the files
-- hold node tags and traffic counters, no credentials, and the containing
-- /var/etc/treadle is created 0700 once at startup below (and re-tightened
-- by every service start), so nobody but root can reach them. At ~200 ms
-- per busybox fork on MIPS, per-tick forks add up fast at a 10 s cadence.
local function save_json(path, tbl)
	local tmp = path .. ".tmp"
	local f = io.open(tmp, "w")
	if not f then return end
	f:write(jsonc.stringify(tbl))
	f:close()
	os.rename(tmp, path)
end

local function status_viewed()
	local t = tonumber((read_file(STATUS_VIEWED) or ""):match("%d+"))
	return t ~= nil and os.time() - t <= VIEWED_WINDOW_S
end

-- Ask procd for sing-box's current pid. Returns the pid (a positive
-- number) on success, or nil when procd reports the instance as
-- stopped / missing / unparseable. Pid changes are our authoritative
-- signal that sing-box restarted between ticks — a /proxies fetch gap
-- only catches restarts slow enough to fail at least one 10s poll, and
-- a config-save-driven restart commonly completes inside that window.
local function singbox_pid()
	local inst = lib.singbox_instance(jsonc)
	return inst and tonumber(inst.pid) or nil
end

-- Extract the relevant slice of the /proxies response: one entry per
-- group, carrying the active member tag and (when available) its most
-- recent latency. Internal helper groups (tag starts with "_") are filtered
-- out. Selectors count only when Treadle manages the groups, since that is
-- the only time Treadle emits one; sanitisation drops those a subscription
-- ships.
local function group_state(parsed, managed)
	local out = {}
	if type(parsed.proxies) ~= "table" then return out end
	for tag, p in pairs(parsed.proxies) do
		if type(p) == "table"
			and (p.type == "URLTest" or (managed and p.type == "Selector"))
			and type(p.now) == "string" and p.now ~= ""
			and tag:sub(1, 1) ~= "_"
		then
			local entry = { now = p.now, type = p.type, members = {} }
			-- Latency lives on the member proxy's history, not the group's.
			local member = parsed.proxies[p.now]
			if type(member) == "table" and type(member.history) == "table" then
				local last = member.history[#member.history]
				if last and type(last.delay) == "number" and last.delay > 0 then
					entry.delay_ms = last.delay
				end
			end
			-- Every member with its latest result, in the group's order, for
			-- the Status page's expandable group rows. No result (none yet,
			-- or the last test failed) leaves delay_ms out.
			if type(p.all) == "table" then
				for _, tag_m in ipairs(p.all) do
					local mp = parsed.proxies[tag_m]
					local d
					if type(mp) == "table" and type(mp.history) == "table" then
						local h = mp.history[#mp.history]
						if h and type(h.delay) == "number" and h.delay > 0 then
							d = h.delay
						end
					end
					entry.members[#entry.members + 1] = { tag = tag_m, delay_ms = d }
				end
			end
			-- A failed dial deletes the active member's test result but not
			-- the selection: sing-box keeps sending new connections to it
			-- until the next scheduled test pass (interval, 3 min by default)
			-- re-selects. A member with no history is that state. A nested
			-- group or unknown member is not judged, and neither is a
			-- selector: its members have no history until Treadle tests them.
			if p.type == "URLTest" and type(member) == "table" and member.type ~= "URLTest"
				and (type(member.history) ~= "table" or #member.history == 0)
			then
				entry.lost = true
			end
			out[tag] = entry
		end
	end
	return out
end

-- Results of the last probe pass (see probe_pass below), saved with every
-- snapshot so the Status page reads one file.
local probe_nodes = {}
local probe_conn

local function save_snapshot(state)
	save_json(SNAPSHOT, {
		groups       = state,
		nodes        = probe_nodes,
		connectivity = probe_conn,
		updated_at   = os.time()
	})
end

local function load_snapshot()
	local parsed = lib.read_json(jsonc, SNAPSHOT) or {}
	return (type(parsed.groups) == "table") and parsed.groups or {}
end

-- previous: the last tick's state, used to detect changes.
-- primed:  true once we've seen at least one successful poll. On a fresh
-- boot (snapshot empty) we still take a poll and stash it, but we don't
-- emit "changed" / "added" lines for groups going from nothing to their
-- first reading — that isn't a flip, it's the initial inventory.
-- fail_streak: count of consecutive fetch failures, so we can surface a
-- single warning after a meaningful run of failures (sing-box restart,
-- crash, clash port wedged) instead of silently going stale. Resets on
-- the next success, logging a recovery line so the gap is bracketed in
-- the syslog timeline.
local FAIL_WARN_AFTER = 6  -- ~one minute of failures at 10s ticks
local POST_EVENT_WINDOW_S = 60  -- relabel-late-arrivals horizon, see below

-- Create the snapshot directory once, 0700 (it cannot vanish on tmpfs
-- while the daemon runs) — save_json relies on it existing so the write
-- path stays fork-light at the 10s tick cadence.
lib.secure_mkdir("/var/etc/treadle")

local previous = load_snapshot()
local primed   = next(previous) ~= nil
local fail_streak = 0
-- Captured at daemon start so the first iteration doesn't mis-detect a
-- restart against nil. If procd is briefly unreachable, last_pid stays
-- at its last known value through the gap — we only treat a true
-- transition (last and new are both numbers and they differ) as a
-- restart, so a pid lookup failure can't synthesise a fake one.
local last_pid = singbox_pid()

-- Post-event relabel window. When an event (prime / sing-box restart /
-- outage recovery) fires, sing-box's urltest hasn't necessarily settled
-- the first probe of every member yet — groups with no `now` are
-- filtered out by group_state() and arrive in /proxies one or two ticks
-- later. Without this, those late arrivals get logged as `now tracked`
-- (the "brand new group" branch in the diff loop), which is misleading:
-- the group existed before the restart, it was just slow to probe. We
-- snapshot the known tag set at each event and, for POST_EVENT_WINDOW_S
-- afterwards, relabel any late-arriving pre-event tag with the same
-- event context so the syslog reads consistently.
local known_pre_event   = {}
local event_context     = "starting"
local post_event_until  = 0

-- Throughput state. /connections returns monotonic counters since
-- sing-box started; we diff against the previous tick to get bytes/sec.
-- Reset semantics: if the new total is *lower* than the previous one,
-- sing-box restarted between ticks (the pid_changed branch covers the
-- visible case, but we also defend against any unobserved restart). Set
-- bps to 0 for that tick and re-baseline.
local prev_total_up   = nil
local prev_total_down = nil
local prev_stats_ts   = nil
-- Per-connection counters from the previous fetch, keyed by connection id,
-- so each outbound's rate can be diffed the same way. Rebuilt on every
-- fetch, so it only ever holds the live connections.
local prev_conn       = {}
-- Set when sing-box restarted on a tick that skipped /connections, so the
-- next fetch does not diff against the old process's counters.
local stats_stale     = false

-- Emit one "active node is X" line per group. Used in two situations
-- that both mean "the user just lost track of the live selection":
--   - prime: daemon's first successful poll — they need to know what
--     state we're attaching to, not just future flips.
--   - recovery: clash API was unreachable for >=1 tick (sing-box
--     likely restarted; procd needs a beat to stop the old process
--     and start the new one, which fails at least one 10s poll).
--     The selections may have changed across the restart; announce
--     the current ones so the syslog has them on the record without
--     the user having to dig into the Status page.
-- Sorted by tag for stable output across runs.
local function log_initial(current, context)
	local tags = {}
	for tag in pairs(current) do tags[#tags + 1] = tag end
	table.sort(tags)
	for _, tag in ipairs(tags) do
		local entry = current[tag]
		local msg = string.format(
			"group '%s': %s with active node %s",
			tag, context, entry.now)
		if entry.delay_ms then
			msg = msg .. string.format(" (%dms)", entry.delay_ms)
		end
		logmsg("info", msg)
	end
end

-- Failover nudge. When a group's active member has lost its test result
-- (it failed a real connection), sing-box keeps using it until the next
-- scheduled test pass. One GET /group/<tag>/delay re-tests the group and
-- re-selects when the pass ends, so traffic moves within seconds instead of
-- up to `interval`. The dead member is always in the pass, and a server that
-- drops packets never answers, so how long the pass lasts depends on the
-- version:
--   1.14 forces a test of every member, 10 at a time, each bounded by the
--        request's `timeout`. Live members answer in well under a second, so
--        NUDGE_TIMEOUT_MS is mostly time spent waiting on the dead one: it
--        is kept short. A member cut off keeps its previous result.
--   Before 1.14 only the members without a fresh result are re-tested, each
--        under sing-box's own 15 s limit; `timeout` does not shorten that, and
--        NUDGE_FETCH_S bounds the fetch above it.
-- At most one nudge per group per NUDGE_COOLDOWN_S: with the whole network
-- down every member is lost and every pass fails, so repeating it faster only
-- adds load. Only the first nudge of a streak is logged.
local NUDGE_COOLDOWN_S = 60
local NUDGE_TIMEOUT_MS = 3000
local NUDGE_FETCH_S    = 20
local nudge_state = {}   -- tag -> { last = os.time(), logged = bool }

local function nudge_groups(current)
	for tag in pairs(nudge_state) do
		local entry = current[tag]
		if not (entry and entry.lost) then nudge_state[tag] = nil end
	end
	local tags = {}
	for tag, entry in pairs(current) do
		if entry.lost then tags[#tags + 1] = tag end
	end
	table.sort(tags)
	for _, tag in ipairs(tags) do
		local st = nudge_state[tag]
		if not st or os.time() - st.last >= NUDGE_COOLDOWN_S then
			if not st then
				st = { logged = false }
				nudge_state[tag] = st
			end
			st.last = os.time()
			if not st.logged then
				st.logged = true
				logmsg("info", string.format(
					"group '%s': active node %s lost its result, re-testing the group",
					tag, current[tag].now))
			end
			-- The tag is percent-encoded, so it cannot break out of the quotes.
			local f = io.popen("uclient-fetch --timeout=" .. NUDGE_FETCH_S
				.. " -qO- 'http://" .. CLASH_HOST .. "/group/"
				.. lib.url_encode(tag) .. "/delay?timeout=" .. NUDGE_TIMEOUT_MS
				.. "' >/dev/null 2>&1")
			if f then f:close() end
		end
	end
end

-- Probe pass, every PROBE_S. sing-box tests group members on each group's
-- interval but never a node used on its own, so the Status page would have
-- no latency for the default node or a rule's node when it is not a group.
-- One GET /proxies/<tag>/delay tests a node through the running instance
-- and records the result on the node, the way a group's test does. The
-- connectivity check is the same test through whatever the default
-- resolves to (a group's current member, or the node itself): CONN_FAIL_AFTER
-- failures in a row mark it failing, logged once, with the recovery logged
-- too. At most PROBE_MAX single nodes per pass, each bounded by
-- PROBE_FETCH_S, so a pass of dead nodes cannot stall the 10 s tick for
-- long.
local PROBE_S          = 60
local PROBE_MAX        = 6
local PROBE_TIMEOUT_MS = 3000
local PROBE_FETCH_S    = 6
-- TREADLE_PROBE_URL lets the smoke test point the probe at a local server.
local PROBE_URL        = os.getenv("TREADLE_PROBE_URL") or "https://www.gstatic.com/generate_204"
local CONN_FAIL_AFTER  = 3
local probe_last       = 0
local conn_streak      = 0
local conn_last_ok     = nil

-- The default node and each enabled rule's node, from UCI. Read per pass
-- through the libuci binding (fork-free) so an applied change is picked up.
local function in_use()
	local ok, res = pcall(function()
		local c = require("uci").cursor()
		local fin = c:get("treadle", "routing", "final_outbound") or ""
		local rules = {}
		c:foreach("treadle", "rule", function(s)
			if s.enabled ~= "0" and s.outbound and s.outbound ~= "" then
				rules[#rules + 1] = s.outbound
			end
		end)
		c:close()
		return { final = fin, rules = rules }
	end)
	return ok and res or { final = "", rules = {} }
end

-- Test one node; its latency in ms, or nil when it did not answer. `url`
-- defaults to PROBE_URL. The clash API ignores a plain http:// URL and tests
-- against its own https default instead.
local function test_node(tag, url)
	-- Tag and URL are percent-encoded, so they cannot break out of the quotes.
	local f = io.popen("uclient-fetch --timeout=" .. PROBE_FETCH_S
		.. " -qO- 'http://" .. CLASH_HOST .. "/proxies/" .. lib.url_encode(tag)
		.. "/delay?timeout=" .. PROBE_TIMEOUT_MS .. "&url=" .. lib.url_encode(url or PROBE_URL)
		.. "' 2>/dev/null")
	if not f then return nil end
	local body = f:read("*a") or ""
	f:close()
	local ok, parsed = pcall(jsonc.parse, body)
	local d = ok and type(parsed) == "table" and tonumber(parsed.delay) or nil
	if d and d > 0 then return d end
	return nil
end

local function probe_pass(parsed, current)
	local proxies = parsed.proxies
	local function known(tag)
		return tag ~= "" and tag ~= "direct" and tag ~= "block"
			and type(proxies[tag]) == "table"
	end
	local function is_group(tag)
		local t = proxies[tag].type
		return t == "URLTest" or t == "Selector"
	end
	local now = os.time()
	local t = in_use()
	local wanted = { t.final }
	for _, r in ipairs(t.rules) do wanted[#wanted + 1] = r end

	local nodes, count = {}, 0
	for _, tag in ipairs(wanted) do
		if known(tag) and not is_group(tag) and not nodes[tag] and count < PROBE_MAX then
			count = count + 1
			nodes[tag] = { delay_ms = test_node(tag), tested_at = now }
		end
	end
	probe_nodes = nodes

	local fin = t.final
	if not known(fin) then
		-- No proxy default (direct, block, unset, or a tag not in the running
		-- config): nothing to check through.
		probe_conn = { state = "none" }
		conn_streak = 0
		return
	end
	local via = fin
	if is_group(fin) then
		via = (current[fin] and current[fin].now) or proxies[fin].now or ""
	end
	local d
	if nodes[via] then
		d = nodes[via].delay_ms
	elseif via ~= "" then
		d = test_node(via)
	end
	if d then
		if conn_streak >= CONN_FAIL_AFTER then
			logmsg("info", string.format(
				"connectivity: through %s again (%dms)", via, d))
		end
		conn_streak = 0
		conn_last_ok = now
	else
		conn_streak = conn_streak + 1
		if conn_streak == CONN_FAIL_AFTER then
			logmsg("warning", string.format(
				"connectivity: %d checks in a row through %s failed", conn_streak, via))
		end
	end
	probe_conn = {
		state      = (conn_streak >= CONN_FAIL_AFTER) and "failing" or (d and "ok" or "retrying"),
		default    = fin,
		via        = via,
		delay_ms   = d,
		streak     = conn_streak,
		last_ok_at = conn_last_ok,
		checked_at = now
	}
end

-- Lightweight UCI peek so the daemon notices a clash_api_enabled or
-- group_manager flip between procd reconciliations. Without it the loop
-- keeps polling 9090 after the user disables clash, eventually logging
-- 'clash API unreachable for N polls' for a feature they explicitly turned
-- off. Read via the libuci binding — fork-free, unlike `uci -q get` — with a
-- fresh cursor per tick so a committed flip is seen immediately. When
-- Treadle manages the groups, each group's test URL, re-check interval and
-- tolerance come along, keyed by tag.
local function settings()
	local ok, res = pcall(function()
		local c = require("uci").cursor()
		local r = {
			clash   = c:get("treadle", "global", "clash_api_enabled") == "1",
			managed = c:get("treadle", "global", "group_manager") == "treadle",
			groups  = {}
		}
		if r.managed then
			c:foreach("treadle", "node", function(s)
				if s.type == "group" and s.tag and s.tag ~= "" then
					r.groups[s.tag] = {
						url       = s.group_test_url,
						interval  = s.group_interval,
						tolerance = tonumber(s.group_tolerance)
					}
				end
			end)
		end
		c:close()
		return r
	end)
	if not ok then return { clash = true, managed = false, groups = {} } end  -- can't tell → keep polling
	return res
end

-- ── Groups Treadle manages ─────────────────────────────────────────────
-- Each tick, for every selector group: re-check all its members once per
-- group interval (one GET /group/<tag>/delay, sing-box tests them 10 at a
-- time), probe the member in use every ACTIVE_PROBE_S or as soon as its
-- traffic starts failing (fail-watch's error file), and ask groupman.lua
-- whether to move. A failed probe of the member in use is repeated at once,
-- so two failures in a row switch the group within seconds. A move is
-- applied with PUT /proxies/<group>; sing-box stores it in the cache file.
local ACTIVE_PROBE_S     = 20
local GROUP_RETEST_S     = 60   -- at most this often when nothing is known to work
local MAX_PROBES         = 8    -- single-node probes per tick, across groups
local DEFAULT_INTERVAL_S = 180  -- sing-box urltest's own default
local MIN_INTERVAL_S     = 30
local GROUP_STATE        = "/var/etc/treadle/.group-state.json"
local CONN_ERRORS        = "/var/etc/treadle/.conn-errors.json"
local GM_DEFAULT_URL     = "https://www.gstatic.com/generate_204"

local gm            -- groupman, loaded on first use
local gm_state      -- its per-member state
local gm_groups     -- tag -> { last_switch, last_test, reason, switched_at, stuck }
local err_seen = {} -- outbound tag -> { t = newest error second taken, n = how many at it }
math.randomseed(os.time())
local function rnd(n) return math.random(n) end

-- "3m", "90s", "1h30m" → seconds. sing-box durations, as the editor stores them.
local function duration_s(v)
	if type(v) ~= "string" or v == "" then return nil end
	local total, matched = 0, false
	for num, unit in v:gmatch("(%d+)(%a+)") do
		local k = ({ h = 3600, m = 60, s = 1, ms = 0.001 })[unit]
		if not k then return nil end
		total, matched = total + tonumber(num) * k, true
	end
	return matched and total or nil
end

local function gm_load()
	gm = dofile("/usr/libexec/treadle/groupman.lua")
	local saved = lib.read_json(jsonc, GROUP_STATE) or {}
	gm_state = (type(saved.members) == "table") and { members = saved.members } or gm.new()
	gm_groups = (type(saved.groups) == "table") and saved.groups or {}
end

-- One pass over every member of a group. Absent from the reply means the
-- member failed. The whole pass shares the request's timeout, so it allows
-- one probe timeout per batch of 10.
local function group_test(tag, members, url, now)
	local budget = PROBE_TIMEOUT_MS * math.ceil(#members / 10) + 2000
	local f = io.popen("uclient-fetch --timeout=" .. math.ceil(budget / 1000 + 5)
		.. " -qO- 'http://" .. CLASH_HOST .. "/group/" .. lib.url_encode(tag)
		.. "/delay?timeout=" .. budget .. "&url=" .. lib.url_encode(url)
		.. "' 2>/dev/null")
	if not f then return end
	local body = f:read("*a") or ""
	f:close()
	local ok, res = pcall(jsonc.parse, body)
	if not ok or type(res) ~= "table" then return end
	for _, m in ipairs(members) do
		local d = tonumber(res[m])
		gm.record(gm_state, m, now, (d and d > 0) and d or nil)
	end
end

-- Switch a selector with PUT /proxies/<group>. uclient-fetch sends it where
-- it has --method (25.12); 24.10's has no PUT and its busybox nc takes no
-- options, so there the raw request goes through nc, killed after
-- PUT_WAIT_S if the API never closes the connection.
local PUT_WAIT_S = 5
local put_via_uclient
local function select_member(group, member)
	local body = jsonc.stringify({ name = member })
	local path = "/var/etc/treadle/.select.req"
	if put_via_uclient == nil then
		local h = io.popen("uclient-fetch --help 2>&1")
		put_via_uclient = (h and h:read("*a") or ""):find("--method", 1, true) ~= nil
		if h then h:close() end
	end
	local w = io.open(path, "w")
	if not w then return false end
	local cmd
	if put_via_uclient then
		w:write(body)
		-- Exit 0 on the 204, non-zero on an error status; the group is
		-- percent-encoded, so it cannot break out of the quotes.
		cmd = "uclient-fetch -q -O /dev/null --timeout=" .. PUT_WAIT_S
			.. " --method=PUT --header='Content-Type: application/json'"
			.. " --body-file=" .. path .. " 'http://" .. CLASH_HOST .. "/proxies/"
			.. lib.url_encode(group) .. "' >/dev/null 2>&1 && echo 'HTTP/1.1 204'"
	else
		w:write("PUT /proxies/" .. lib.url_encode(group) .. " HTTP/1.1\r\n"
			.. "Host: " .. CLASH_HOST .. "\r\n"
			.. "Content-Type: application/json\r\n"
			.. "Content-Length: " .. #body .. "\r\n"
			.. "Connection: close\r\n\r\n" .. body)
		cmd = "nc " .. CLASH_HOST:gsub(":", " ") .. " < " .. path .. " > " .. path .. ".out 2>/dev/null & p=$!; "
			.. "n=0; while kill -0 $p 2>/dev/null && [ $n -lt " .. PUT_WAIT_S .. " ]; do sleep 1; n=$((n + 1)); done; "
			.. "kill $p 2>/dev/null; head -n 1 " .. path .. ".out"
	end
	w:close()
	local h = io.popen(cmd)
	local out = h and h:read("*a") or ""
	if h then h:close() end
	os.remove(path)
	os.remove(path .. ".out")
	return out:find("HTTP/1%.%d 204") ~= nil
end

-- Charge fail-watch's new connection errors to members. An error naming a
-- managed group (sing-box 1.14) goes to the member that group is using; one
-- naming a member (1.12, 1.13) goes to that member. Returns the set of
-- groups whose member in use has new errors, to probe it this tick.
local function take_errors(current, now)
	local hit = {}
	local parsed = lib.read_json(jsonc, CONN_ERRORS)
	if not parsed or type(parsed.errors) ~= "table" then return hit end
	local using = {}
	for tag, g in pairs(current) do
		if g.managed then using[g.now] = tag end
	end
	for tag, times in pairs(parsed.errors) do
		if type(times) == "table" then
			-- Times are in arrival order and whole seconds, so several can
			-- share the newest second: count how many of those were taken.
			local seen = err_seen[tag] or { t = 0, n = 0 }
			local fresh, same = {}, 0
			for _, t in ipairs(times) do
				t = tonumber(t)
				if t and t == seen.t then
					same = same + 1
					if same > seen.n then fresh[#fresh + 1] = t end
				elseif t and t > seen.t then
					fresh[#fresh + 1] = t
				end
			end
			local last = tonumber(times[#times])
			if last and last >= seen.t then
				local n = 0
				for _, t in ipairs(times) do if tonumber(t) == last then n = n + 1 end end
				err_seen[tag] = { t = last, n = n }
			end
			if #fresh > 0 then
				local member = tag
				if current[tag] and current[tag].managed then member = current[tag].now end
				gm.add_errors(gm_state, member, now, fresh)
				if using[member] then hit[using[member]] = true end
			end
		end
	end
	return hit
end

local function manage_groups(current, cfg)
	if not gm then gm_load() end
	local now = os.time()
	local tags, wanted = {}, {}
	for tag, g in pairs(current) do
		if g.type == "Selector" then
			g.managed = true
			tags[#tags + 1] = tag
			for _, m in ipairs(g.members) do wanted[m.tag] = true end
		end
	end
	table.sort(tags)
	-- Forget members no group has any more, and groups that are gone.
	for tag in pairs(gm_state.members) do
		if not wanted[tag] then gm_state.members[tag] = nil end
	end
	for tag in pairs(gm_groups) do
		if not current[tag] then gm_groups[tag] = nil end
	end

	local hit = take_errors(current, now)
	local probes = MAX_PROBES
	-- Re-check the group whose last pass is oldest, one per tick.
	local due, due_age
	for _, tag in ipairs(tags) do
		local meta = gm_groups[tag]
		if not meta then
			-- First sight (daemon start or a new group): the member in use was
			-- chosen before, by Treadle or the config's default; keep it for a
			-- dwell unless it fails.
			meta = { last_switch = now, last_test = 0 }
			gm_groups[tag] = meta
		end
		local gc = cfg.groups[tag] or {}
		local interval = duration_s(gc.interval) or DEFAULT_INTERVAL_S
		if interval < MIN_INTERVAL_S then interval = MIN_INTERVAL_S end
		local age = now - (meta.last_test or 0)
		if age >= interval and (not due or age > due_age) then due, due_age = tag, age end
	end

	for _, tag in ipairs(tags) do
		local g, meta = current[tag], gm_groups[tag]
		local gc = cfg.groups[tag] or {}
		local url = (gc.url and gc.url ~= "") and gc.url or GM_DEFAULT_URL
		local interval = math.max(duration_s(gc.interval) or DEFAULT_INTERVAL_S, MIN_INTERVAL_S)
		local members = {}
		for _, m in ipairs(g.members) do members[#members + 1] = m.tag end

		if tag == due then
			group_test(tag, members, url, now)
			meta.last_test = now
		end
		local r = gm.member(gm_state, g.now)
		if probes > 0 and (hit[tag] or now - (r.tested_at or 0) >= ACTIVE_PROBE_S) then
			local d = test_node(g.now, url)
			gm.record(gm_state, g.now, now, d)
			probes = probes - 1
			if not d and probes > 0 then
				d = test_node(g.now, url)
				gm.record(gm_state, g.now, os.time(), d)
				probes = probes - 1
			end
		end

		local view = { now = g.now, members = members, tolerance = gc.tolerance,
			fresh_s = 2 * interval, last_switch = meta.last_switch }
		local dec = gm.decide(gm_state, view, os.time(), rnd)
		if dec.need_test and os.time() - (meta.last_test or 0) >= GROUP_RETEST_S then
			group_test(tag, members, url, os.time())
			meta.last_test = os.time()
			dec = gm.decide(gm_state, view, os.time(), rnd)
		end
		if dec.to then
			if select_member(tag, dec.to) then
				logmsg("info", string.format("group '%s': active node %s -> %s (%s)",
					tag, g.now, dec.to, dec.reason))
				meta.last_switch, meta.switched_at, meta.reason = os.time(), os.time(), dec.reason
				meta.stuck = nil
				g.now = dec.to
				local nr = gm_state.members[dec.to]
				g.delay_ms = nr and nr.ewma and math.floor(nr.ewma) or nil
			else
				logmsg("warning", string.format("group '%s': could not switch to %s", tag, dec.to))
			end
		elseif dec.need_test and not meta.stuck then
			meta.stuck = true
			logmsg("warning", string.format(
				"group '%s': %s, and no other member is known to work", tag, dec.reason))
		elseif not dec.need_test then
			meta.stuck = nil
		end

		-- What the Status page shows about the choice.
		g.reason, g.switched_at = meta.reason, meta.switched_at
		for _, m in ipairs(g.members) do
			local mr = gm_state.members[m.tag]
			if mr then
				local ok, n = gm.rate(mr)
				m.passed, m.tests = ok, n
				if gm.benched(mr, now) then m.benched_until = mr.bench_until end
				local errs = gm.recent_errors(mr, now)
				if errs > 0 then m.errors = errs end
			end
		end
	end
	save_json(GROUP_STATE, { members = gm_state.members, groups = gm_groups })
end

while true do
	local cfg = settings()
	if not (cfg.clash or cfg.managed) then
		-- Reset transient state so a re-enable doesn't surface a stale
		-- 'reachable again' on the first successful fetch.
		fail_streak = 0
		primed      = false
		last_pid    = nil
		flush_log()
		os.execute("sleep " .. tostring(POLL_S))
	else
	local parsed = fetch_json("/proxies")
	if parsed then
		if fail_streak >= FAIL_WARN_AFTER then
			logmsg("info", string.format(
				"clash API reachable again after %d failed polls",
				fail_streak))
		end
		local had_outage = (fail_streak > 0)
		fail_streak = 0

		-- pid check after a successful fetch so we don't burn an ubus
		-- call when we already know things are degraded. A pid change
		-- here means: between our last successful tick and this one,
		-- procd restarted sing-box — which is the primary case we want
		-- to catch even when the restart is faster than our 10s poll.
		local pid = singbox_pid()
		local pid_changed = (last_pid and pid and pid ~= last_pid)
		if pid then last_pid = pid end

		local current = group_state(parsed, cfg.managed)

		local event_tick = (not primed) or had_outage or pid_changed
		if event_tick then
			-- Cold prime, post-outage recovery, or sing-box pid changed
			-- under us — in each case the previous snapshot is either
			-- empty or no longer authoritative about the new sing-box's
			-- selections. Re-announce every group so the user sees which
			-- node each urltest landed on after the event, not just
			-- future flips. Diff loop skipped this tick; next
			-- tick's diff runs against the snapshot we save below.
			event_context = (not primed) and "starting"
				or pid_changed and "after sing-box restart"
				or "resuming"
			-- Snapshot the union of last-known and currently-visible
			-- tags for late-arrival relabeling. Two cases this covers:
			-- (a) tags in `previous` not in `current` — group existed
			--     before the event but its post-event probe hasn't
			--     settled yet (sing-box's `now` is empty, filtered out);
			-- (b) tags in `current` not in `previous` — group was
			--     announced THIS tick, so future ticks shouldn't treat
			--     it as a brand-new arrival either.
			known_pre_event = {}
			for tag in pairs(previous) do known_pre_event[tag] = true end
			for tag in pairs(current)  do known_pre_event[tag] = true end
			post_event_until = os.time() + POST_EVENT_WINDOW_S
			log_initial(current, event_context)
		else
			local in_window = (os.time() < post_event_until)
			-- Member changed within a still-existing group: the central
			-- diagnostic — this is the "is my urltest flipping too
			-- often" signal the user is hunting.
			for tag, entry in pairs(current) do
				local old = previous[tag]
				if old and old.now and old.now ~= entry.now then
					local msg = string.format(
						"group '%s': active node %s -> %s",
						tag, old.now, entry.now)
					if entry.delay_ms then
						msg = msg .. string.format(" (%dms)", entry.delay_ms)
					end
					logmsg("info", msg)
				elseif not old then
					-- Tag not in last tick's snapshot. Two cases that
					-- need distinct labels:
					if in_window and known_pre_event[tag] then
						-- (1) The group existed before the most recent
						-- event but its probe is only now reporting a
						-- `now`. Relabel with the same context the
						-- event was logged under so the syslog reads
						-- consistently — the user sees one event line
						-- per group regardless of whether sing-box's
						-- internal probe order put it on tick N or N+1.
						local msg = string.format(
							"group '%s': %s with active node %s",
							tag, event_context, entry.now)
						if entry.delay_ms then
							msg = msg .. string.format(" (%dms)", entry.delay_ms)
						end
						logmsg("info", msg)
					else
						-- (2) Genuinely new group: appeared in /proxies
						-- since the last event (user added it, or a
						-- reload pulled it into the running config).
						logmsg("info", string.format(
							"group '%s': now tracked, active node %s",
							tag, entry.now))
					end
				end
			end
			-- Group disappeared between ticks. Suppress the line during
			-- the post-event window for tags that were in the pre-event
			-- set — they're more likely still mid-probe than truly gone,
			-- and a transient "no longer present" / "now tracked" pair
			-- on every restart would be pure noise. Genuine removals
			-- (tag wasn't in pre-event set) and removals that persist
			-- past the window are still logged.
			for tag, _ in pairs(previous) do
				if not current[tag] then
					if not (in_window and known_pre_event[tag]) then
						logmsg("info", string.format(
							"group '%s': no longer present", tag))
					end
				end
			end
		end

		-- Not on an event tick, for the same reason as the nudge below: a
		-- fresh sing-box is still running its own first test pass.
		if not event_tick and os.time() - probe_last >= PROBE_S then
			probe_last = os.time()
			probe_pass(parsed, current)
		end

		-- Before the snapshot, so a switch made here is what it records and
		-- the next tick's diff does not log it a second time.
		if cfg.managed then manage_groups(current, cfg) end

		save_snapshot(current)
		previous = current
		primed   = true

		-- ── Throughput / connections snapshot ─────────────────────────
		-- Same tick, second HTTP call, every tick while the Status page is
		-- open and once per STATS_IDLE_S otherwise (see STATUS_VIEWED).
		-- Failure is non-fatal: we skip the stats write rather than
		-- dropping the proxies work we just did. A pid change since the
		-- last fetch or a counter regression both mean "the previous
		-- baseline is invalid"; zero the rate and re-baseline so the next
		-- diff is honest.
		if pid_changed then stats_stale = true end
		local conns
		if status_viewed() or not prev_stats_ts
			or os.time() - prev_stats_ts >= STATS_IDLE_S
		then
			conns = fetch_json("/connections")
		end
		if conns then
			local total_up   = tonumber(conns.uploadTotal)   or 0
			local total_down = tonumber(conns.downloadTotal) or 0
			local cs = (type(conns.connections) == "table") and #conns.connections or 0
			local mem = tonumber(conns.memory)
			local now_ts = os.time()
			local up_bps, down_bps = 0, 0
			local dt = 0
			if prev_total_up and prev_total_down and prev_stats_ts
				and not stats_stale
				and total_up >= prev_total_up
				and total_down >= prev_total_down
			then
				dt = now_ts - prev_stats_ts
				if dt > 0 then
					up_bps   = math.floor((total_up   - prev_total_up)   / dt)
					down_bps = math.floor((total_down - prev_total_down) / dt)
				end
			end
			-- Rate per outbound tag. A connection counts toward every tag on
			-- its chain (the node and any group it went through), so a
			-- group's figure is the sum of its members. A connection first
			-- seen this tick counts from zero: it opened inside the window.
			-- Bytes a connection moved and closed between two ticks are
			-- not seen; that undercounts short flows slightly.
			local by_tag, cur_conn = {}, {}
			local conn_list = (type(conns.connections) == "table") and conns.connections or {}
			for _, cn in ipairs(conn_list) do
				local cu = tonumber(cn.upload)   or 0
				local cd = tonumber(cn.download) or 0
				if cn.id then cur_conn[cn.id] = { cu, cd } end
				if dt > 0 and type(cn.chains) == "table" then
					local p = prev_conn[cn.id]
					local du = cu - (p and p[1] or 0)
					local dd = cd - (p and p[2] or 0)
					if du < 0 then du = 0 end
					if dd < 0 then dd = 0 end
					if du > 0 or dd > 0 then
						local seen = {}
						for _, tag in ipairs(cn.chains) do
							if not seen[tag] then
								seen[tag] = true
								local t = by_tag[tag]
								if not t then t = { up = 0, down = 0 }; by_tag[tag] = t end
								t.up   = t.up   + du
								t.down = t.down + dd
							end
						end
					end
				end
			end
			prev_conn = cur_conn
			for tag, t in pairs(by_tag) do
				t.up   = math.floor(t.up   / dt)
				t.down = math.floor(t.down / dt)
				if t.up == 0 and t.down == 0 then by_tag[tag] = nil end
			end
			save_json(STATS_SNAP, {
				up_bps     = up_bps,
				down_bps   = down_bps,
				by_tag     = by_tag,
				total_up   = total_up,
				total_down = total_down,
				conn_count = cs,
				mem_inuse  = mem,
				updated_at = now_ts
			})
			prev_total_up   = total_up
			prev_total_down = total_down
			prev_stats_ts   = now_ts
			stats_stale     = false
		end
		-- Last, because it can block for seconds. Not on a tick that
		-- re-announced the groups (cold start, outage recovery, sing-box
		-- restart): a fresh sing-box has no results yet and runs its own
		-- first test pass.
		if not event_tick then nudge_groups(current) end
	else
		fail_streak = fail_streak + 1
		-- One warning at the threshold, not one per failed tick — the
		-- syslog tail on the Status page is finite and the user needs
		-- one clear signal, not a flood. Subsequent failures stay
		-- silent until the streak breaks (which logs the recovery).
		if fail_streak == FAIL_WARN_AFTER then
			logmsg("warning", string.format(
				"clash API unreachable for %d consecutive polls (~%ds) — sing-box may be down or the clash listener not bound",
				fail_streak, fail_streak * POLL_S))
		end
	end
	-- Drain queued log lines before sleeping. One logger fork per
	-- severity level instead of one per line — a flip burst over many
	-- groups stays well inside the POLL_S budget.
	flush_log()
	os.execute("sleep " .. tostring(POLL_S))
	end  -- else (clash API in use)
end
