#
# treadle watchdog — cron-driven recovery for sing-box.
#
# procd respawns a crashed sing-box, but after a burst of fast crashes it
# hits its respawn retry limit and gives up: the instance stays down while
# the TPROXY firewall rules and the dnsmasq drop-in remain in place, which
# blackholes the whole LAN — with no recovery and only procd's own syslog
# line to show for it. Run every few minutes by cron, this script detects
# the "enabled but not running" state, logs it, and re-arms the service
# with a fresh start, which hands procd a new instance and resets its
# respawn counter. A genuinely broken sing-box is thus retried at cron
# cadence rather than giving up forever.

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

config_load treadle
config_get_bool enabled global enabled 0

# Nothing to watch when the service is intentionally stopped.
# shellcheck disable=SC2154  # set by config_get_bool
[ "$enabled" = "1" ] || exit 0

# A transient pause (Status page Stop button) writes /var/run/treadle.paused
# and stops the service without flipping the persistent `enabled` flag. Skip
# re-arming while paused — otherwise this watchdog would undo the user's
# action within 5 minutes. The marker is on tmpfs, so a reboot clears it
# and an enabled-but-paused service resumes naturally.
[ -e /var/run/treadle.paused ] && exit 0

# procd's own view, scoped to the named `singbox` instance. The treadle
# service also carries `active_watch` when clash API is enabled, so we
# must walk the JSON to the specific instance — ubus's `instance`
# parameter is accepted-but-ignored on some procd versions (the reply
# still includes every instance), so a substring grep for
# `"running": true` would happily match the watcher's status and let
# the watchdog believe sing-box is alive when only the watcher is.
# That's the LAN-blackhole this watchdog exists to recover from.
ubus_out=$(ubus call service list '{"name":"treadle"}' 2>/dev/null)
running=
if [ -n "$ubus_out" ]; then
	json_load "$ubus_out"
	if json_select treadle >/dev/null 2>&1 && \
	   json_select instances >/dev/null 2>&1 && \
	   json_select singbox >/dev/null 2>&1; then
		json_get_var running running
	fi
fi
# ── Rule-set downloads that failed at startup ─────────────────────────────
#
# A remote rule-set that is not cached yet is downloaded when sing-box starts.
# If that download fails, sing-box 1.12/1.13 exit (FATAL), and procd gives up
# after a few respawns. From 1.14 it starts on an empty placeholder
# (build-config's initial_path), but the rules match nothing, and sing-box
# does not retry for a whole update_interval (1 d). A plain restart would
# repeat the same failure, because a urltest default starts on its untested
# first member again. So retry once by the other download route (the flag
# build-config reads), then alternate, backing off 5 → 10 → 20 → 40 → 60 min.
# A run that got through its first minutes without such a failure resets the
# backoff. Only failures within that window count, so a failed daily refresh
# (the cached copy still works) never triggers a restart.
config_get cfg global config_path /var/etc/treadle/sing-box.json
FLIP=/var/run/treadle.ruleset-flip
RETRY=/var/run/treadle.ruleset-retry
WINDOW=900
FLIP_TTL=3600
# A rule-set that can never be fetched (a mistyped custom URL, a host that is
# gone) would otherwise restart sing-box every hour for good. After this many
# attempts, stop and say so. Any start the watchdog did not make itself (a
# settings save, a manual restart, WAN coming up, a boot) clears the state
# and allows a fresh round, so fixing the URL is enough.
MAX_ATTEMPTS=6

# rs_retry <reason>: flip or restore the download route and start again, or
# return 1 while the backoff says not yet.
rs_retry() {
	now=$(cut -d. -f1 /proc/uptime)
	attempt=0
	next=0
	gave_up=
	[ -f "$RETRY" ] && read -r attempt next gave_up < "$RETRY"
	if [ "$attempt" -ge "$MAX_ATTEMPTS" ]; then
		if [ -z "$gave_up" ]; then
			echo "$attempt $next gave-up" > "$RETRY"
			logger -p daemon.err -t treadle \
				"watchdog: $1, still failing after $attempt attempts by both routes; giving up. Check the rule-set URLs, then save or restart to retry"
		fi
		return 1
	fi
	[ "$now" -lt "${next:-0}" ] && return 1
	attempt=$((attempt + 1))
	wait=300
	i=1
	while [ "$i" -lt "$attempt" ] && [ "$wait" -lt 3600 ]; do
		wait=$((wait * 2))
		i=$((i + 1))
	done
	[ "$wait" -gt 3600 ] && wait=3600
	echo "$attempt $((now + wait))" > "$RETRY"
	if [ $((attempt % 2)) -eq 1 ]; then
		echo "$((now + FLIP_TTL))" > "$FLIP"
		route="the other route than configured"
	else
		rm -f "$FLIP"
		route="the configured route"
	fi
	logger -p daemon.warn -t treadle \
		"watchdog: $1; retrying rule-set downloads via $route (attempt $attempt of $MAX_ATTEMPTS)"
	TREADLE_WATCHDOG=1 /etc/init.d/treadle start >/dev/null 2>&1
	return 0
}

if [ "$running" = "1" ]; then
	# shellcheck disable=SC2154  # set by config_get
	pid=$(pgrep -f "^/usr/bin/sing-box run -c $cfg" | head -n 1)
	[ -n "$pid" ] || exit 0
	# The run's start as an epoch. Not /proc/<pid>'s own timestamp: that is
	# when the entry was first looked up, which can be long after the start.
	# Field 22 of /proc/<pid>/stat is the start in clock ticks since boot
	# (USER_HZ, 100 on every OpenWrt target); the ") " cut skips the command
	# name, which may contain spaces.
	ticks=$(sed 's/^.*) //' "/proc/$pid/stat" 2>/dev/null | cut -d ' ' -f 20)
	[ -n "$ticks" ] || exit 0
	epoch=$(date +%s)
	start=$(( epoch - $(cut -d. -f1 /proc/uptime) + ticks / 100 ))
	# Failed downloads this run logged within WINDOW of its start. Lines from
	# before the start belong to an earlier process that had the same pid.
	# logread -t puts the epoch in the first [...] of each line; one second
	# of slack covers the rounding on both sides.
	early=$(logread -t 2>/dev/null | grep -F "sing-box[$pid]:" \
		| grep -F "fetch rule-set" \
		| sed -n 's/^[^[]*\[\([0-9]*\)\..*/\1/p' \
		| awk -v s="$start" -v w="$WINDOW" '$1 >= s - 1 && $1 - s <= w { n++ } END { print n + 0 }')
	if [ "$early" -gt 0 ]; then
		rs_retry "a rule-set download failed after sing-box started"
	elif [ $(( epoch - start )) -gt "$WINDOW" ]; then
		rm -f "$RETRY"
	fi
	exit 0
fi

# Not running. When the last sing-box run died initialising a rule-set, retry
# by the other route instead of re-arming on the one that just failed.
last=$(logread 2>/dev/null | grep -oE "sing-box\[[0-9]+\]:" | tail -n 1)
if [ -n "$last" ] && logread 2>/dev/null | grep -F "$last" | grep -q "initialize rule-set"; then
	rs_retry "sing-box failed to start on a rule-set download" && exit 0
fi

logger -p daemon.err -t treadle \
	"watchdog: sing-box is enabled but not running — re-arming the service"
TREADLE_WATCHDOG=1 /etc/init.d/treadle start >/dev/null 2>&1
